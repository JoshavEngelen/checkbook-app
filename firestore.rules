rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function bookOwnerId(bookId) {
      return get(/databases/$(database)/documents/books/$(bookId)).data.ownerId;
    }

    match /books/{bookId} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /categories/{categoryId} {
      allow read, delete: if isOwner(bookOwnerId(resource.data.bookId));
      allow create: if isOwner(bookOwnerId(request.resource.data.bookId));
      allow update: if isOwner(bookOwnerId(resource.data.bookId))
        && request.resource.data.bookId == resource.data.bookId;
    }

    match /transactions/{transactionId} {
      allow read, delete: if isOwner(bookOwnerId(resource.data.bookId));
      allow create: if isOwner(bookOwnerId(request.resource.data.bookId));
      allow update: if isOwner(bookOwnerId(resource.data.bookId))
        && request.resource.data.bookId == resource.data.bookId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
